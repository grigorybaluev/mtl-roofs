# Copy to .env and adjust. .env is git-ignored.
# Consumed by docker-compose.yml and by mtl_roofs.config.Settings.

POSTGRES_DB=mtl_roofs
POSTGRES_USER=mtl_roofs
POSTGRES_PASSWORD=change-me-locally

# Host port for the PostGIS container. 5432 is frequently already taken by another
# project's database, so this project defaults to 5433.
POSTGRES_PORT=5433

MTL_ROOFS_POSTGRES_HOST=localhost
MTL_ROOFS_POSTGRES_PORT=5433
MTL_ROOFS_POSTGRES_DB=mtl_roofs
MTL_ROOFS_POSTGRES_USER=mtl_roofs
MTL_ROOFS_POSTGRES_PASSWORD=change-me-locally
